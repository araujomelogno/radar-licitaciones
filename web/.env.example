# Configuración web de Firebase (Consola Firebase → Configuración del proyecto → Tus apps → Web).
# Si faltan, la app arranca en modo demo con datos de ejemplo.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Región de las Cloud Functions callable.
VITE_FUNCTIONS_REGION=southamerica-east1
# 1 = forzar modo demo (datos en memoria, sin Firebase).
VITE_DEMO=0
